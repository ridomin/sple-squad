{
  "name": "sple",
  "version": "0.0.0",
  "private": true,
  "description": "Command-line tool for managing music-streaming playlists (Spotify first, provider-extensible).",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "sple": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "schemas/*.schema.json"
  ],
  "exports": {
    "./schemas/*.schema.json": "./schemas/*.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/cli/index.js",
    "test": "node --test",
    "test:coverage": "npm run test:coverage:core && npm run test:coverage:provider",
    "test:coverage:core": "node --test --experimental-test-coverage --test-coverage-include-all --test-coverage-include='src/core/**/*.ts' --test-coverage-lines=80",
    "test:coverage:provider": "node --test --experimental-test-coverage --test-coverage-include-all --test-coverage-include='src/provider/**/*.ts' --test-coverage-lines=80",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^22.9.0",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "eslint-config-love": "^158.0.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "debug": "^4.4.3"
  }
}
